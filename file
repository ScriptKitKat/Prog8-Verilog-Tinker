Here’s a framework for structuring your Tinker CPU. The core issue is that your top-level module is missing the control logic that actually connects everything — right now your submodules are instantiated but not wired together, and the case statement is floating outside any always block.
Here’s how I’d restructure it:
The Big Picture
Think of your CPU as a pipeline with these stages, all orchestrated by control signals from the top-level module:
Fetch → Decode → Execute (ALU/FPU) → Memory → Writeback
Your submodules are the datapath. What you’re missing is the control path — the logic that sets muxes, write-enables, and routes data between modules based on the opcode.
Restructured Top-Level

module tinker_core(
    input clk,
    input reset
);
    // === PC Logic ===
    reg [63:0] PC;
    wire [63:0] next_PC;
    wire branch_taken;
    
    always @(posedge clk or posedge reset) begin
        if (reset)
            PC <= `START;
        else
            PC <= next_PC;
    end
    
    // Default: PC+4. Branches/jumps override this.
    assign next_PC = branch_taken ? branch_target : PC + 4;

    // === Fetch ===
    wire [31:0] instruction;
    assign instruction = {mem_array[PC+3], mem_array[PC+2], mem_array[PC+1], mem_array[PC]};
    // (or route through your memory module with a fetch port)

    // === Decode ===
    wire [4:0] opcode, rd, rs, rt;
    wire [11:0] L;
    instruction_decoder decoder(.instruction(instruction),
        .opcode(opcode), .rd(rd), .rs(rs), .rt(rt), .L(L));

    // === Control Signals (derived from opcode) ===
    reg reg_write_en, mem_read_en, mem_write_en;
    reg alu_src;        // 0 = register, 1 = immediate
    reg [1:0] wb_src;   // 00 = ALU, 01 = memory, 10 = FPU
    reg is_branch;

    always @(*) begin
        // defaults
        reg_write_en = 0; mem_read_en = 0; mem_write_en = 0;
        alu_src = 0; wb_src = 2'b00; is_branch = 0;

        casez (opcode)
            5'b11_0??: begin // ALU reg-reg (ADD, SUB, MUL, DIV)
                reg_write_en = 1;
                wb_src = 2'b00;
            end
            5'b11_1??: begin // ALU immediate (ADDI, SUBI)
                reg_write_en = 1;
                alu_src = 1;
                wb_src = 2'b00;
            end
            5'b00_???: begin // Bitwise/shifts
                reg_write_en = 1;
                wb_src = 2'b00;
            end
            5'b01_0??: begin // Loads
                reg_write_en = 1;
                mem_read_en = 1;
                wb_src = 2'b01;
            end
            5'b01_1??: begin // Stores
                mem_write_en = 1;
            end
            // FPU, branches, etc.
        endcase
    end

    // === Register File ===
    wire [63:0] read_data1, read_data2, write_data;
    register regfile(.clk(clk), .reset(reset),
        .data(write_data), .r1(rs), .r2(rt),
        .write_reg(reg_write_en ? rd : 5'b0),
        .read_data1(read_data1), .read_data2(read_data2));

    // === ALU ===
    wire [63:0] alu_operand2 = alu_src ? {{52{L[11]}}, L} : read_data2;
    wire [63:0] alu_result;
    ALU alu(.opcode(opcode), .operand1(read_data1),
        .operand2(alu_operand2), .result(alu_result));

    // === Memory ===
    wire [63:0] mem_read_data;
    memory mem(.clk(clk),
        .mem_write(mem_write_en ? alu_result : 64'b0),
        .mem_read(mem_read_en ? alu_result[31:0] : 32'b0),
        .write_data(read_data2), .read_data(mem_read_data));

    // === Writeback Mux ===
    assign write_data = (wb_src == 2'b01) ? mem_read_data :
                        (wb_src == 2'b10) ? fpu_result :
                         alu_result;
endmodule


Key Bugs in Your Current Code
Register module: reads should be combinational, not clocked. Right now you only read when write_reg == 0, which means reads and writes can’t happen in the same cycle:

// Reads are combinational (always available)
assign read_data1 = registers[r1];
assign read_data2 = registers[r2];

// Writes are sequential
always @(posedge clk or posedge reset) begin
    if (reset) begin
        // ... reset logic
    end else if (write_reg != 0) begin
        registers[write_reg] <= data;
    end
end


Memory module: you’re using mem_write as both a flag and an address (it’s 64 bits). Split it into an enable signal and a separate address port. Same issue with mem_read — an address shouldn’t double as a control signal.
Instruction fetch: your fetch module references PC but PC is declared in the top-level module, not inside instruction_fetch. Move PC management to the top level (as shown above) and have fetch just be memory access.
register[i]: should be registers[i] — you named the array registers but index it as register.
What to Build Next
The order I’d tackle things: get ALU instructions working end-to-end first (fetch → decode → execute → writeback to register file). Verify with a testbench that you can execute ADD r1, r2, r3. Then add loads/stores, then branches. FPU last since you know that needs a manual IEEE 754 implementation anyway.
The casez patterns I used above are just a starting point — map them to your actual Tinker ISA encoding. The important thing is that control signal generation lives in one clean always @(*) block so you can see at a glance what each instruction type does.​​​​​​​​​​​​​​​​